<Window x:Class="SetupStudio.InstallerPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предпросмотр установщика" Width="780" Height="620" ResizeMode="NoResize" SizeToContent="Manual"
        WindowStartupLocation="CenterOwner" Background="#EEF2F7">
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Предпросмотр установщика" FontSize="18" FontWeight="Bold" Foreground="#0F766E" VerticalAlignment="Center"/>
            <TextBlock x:Name="SlideTitle" DockPanel.Dock="Right" Foreground="#64748B" VerticalAlignment="Center"/>
        </DockPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="14">
            <Canvas x:Name="PreviewCanvas" Width="680" Height="460" Background="White" ClipToBounds="True"/>
        </Border>
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="BackButton" Content="← Назад" Click="Back_Click" Width="100"/>
            <Button x:Name="NextButton" Content="Далее →" DockPanel.Dock="Right" Click="Next_Click" Width="100" Background="#0D9488" Foreground="White"/>
            <Button Content="Закрыть" DockPanel.Dock="Right" Click="Close_Click" Width="90"/>
        </DockPanel>
    </Grid>
</Window>
